# Configure these in your hosting dashboard. Never commit real credentials.
# Supabase Dashboard > Connect > Session pooler, IPv4 compatible.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
# Render supplies RENDER_EXTERNAL_URL automatically; PUBLIC_URL is optional there.
# PUBLIC_URL=https://your-service.onrender.com
# If Supabase requires its root certificate, paste the PEM in DATABASE_CA.
# DATABASE_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Local only: leave DATABASE_URL unset to use SQLite in ./data.
